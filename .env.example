# Copy this file to .env and adjust it. docker compose reads .env automatically.

# Database password. Use letters, digits and hyphens only: it becomes part of a URL.
POSTGRES_PASSWORD=change-me

# Port on the host machine
SHARE_PUBLISH_PORT=3006

# Delete shares N days after their last upload (0 = keep forever)
SHARE_RETENTION_DAYS=30
SHARE_CLEANUP_INTERVAL_MINUTES=60

# Share page display
SHARE_SHOW_COST=false
SHARE_SHOW_TOKENS=false
# none | name (project folder only) | full
SHARE_SHOW_DIRECTORY=name
SHARE_FINAL_ANSWERS_ONLY=true

RUST_LOG=opencode_share=info,tower_http=info

# Only needed when running without Docker (cargo run):
# DATABASE_URL=postgres://postgres:change-me@localhost:5432/opencode_share
# HOST=0.0.0.0
# PORT=3006
